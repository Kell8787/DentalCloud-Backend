POSTGRES_USER=DentalAdmin
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=DentalCloudDB

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_db:5432/DentalCloudDB
SPRING_DATASOURCE_USERNAME=DentalAdmin
SPRING_DATASOURCE_PASSWORD=change-this-local-password
SPRING_PROFILES_ACTIVE=local
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=1

# Usa un valor largo y diferente por entorno. No reutilices este ejemplo en producción.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=1296000000
